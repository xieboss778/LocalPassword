{
  "name": "local-vault",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/local-vault/src",
  "projectType": "library",
  "tags": ["scope:local-vault", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/local-vault",
        "main": "libs/local-vault/src/index.ts",
        "tsConfig": "libs/local-vault/tsconfig.lib.json",
        "assets": [],
        "rootDir": "libs/local-vault/src"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/local-vault/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/local-vault/jest.config.js"
      }
    }
  }
}

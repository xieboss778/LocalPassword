{
  "compilerOptions": {
    "strict": false,
    "pretty": true,
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "target": "ES2016",
    "module": "ES2020",
    "lib": ["es5", "es6", "es7", "dom", "ES2021", "ESNext.Disposable"],
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "outDir": "dist",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "allowJs": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "paths": {
      "@localpass/admin-console/common": ["./libs/admin-console/src/common"],
      "@localpass/angular/*": ["./libs/angular/src/*"],
      "@localpass/assets": ["./libs/assets/src/index.ts"],
      "@localpass/assets/svg": ["./libs/assets/src/svg/index.ts"],
      "@localpass/auth/angular": ["./libs/auth/src/angular"],
      "@localpass/auth/common": ["./libs/auth/src/common"],
      "@localpass/auto-confirm": ["./libs/auto-confirm/src/index.ts"],
      "@localpass/auto-confirm/angular": ["./libs/auto-confirm/src/angular"],
      "@localpass/automation-driver": ["./libs/automation-driver/src/index.ts"],
      "@localpass/browser/*": ["./apps/browser/src/*"],
      "@localpass/client-type": ["./libs/client-type/src/index.ts"],
      "@localpass/common/spec": ["./libs/common/spec"],
      "@localpass/common/*": ["./libs/common/src/*"],
      "@localpass/components": ["./libs/components/src"],
      "@localpass/core-test-utils": ["./libs/core-test-utils/src/index.ts"],
      "@localpass/desktop/*": ["./apps/desktop/src/*"],
      "@localpass/generator-components": ["./libs/tools/generator/components/src"],
      "@localpass/generator-core": ["./libs/tools/generator/core/src"],
      "@localpass/generator-history": ["./libs/tools/generator/extensions/history/src"],
      "@localpass/generator-legacy": ["./libs/tools/generator/extensions/legacy/src"],
      "@localpass/generator-navigation": ["./libs/tools/generator/extensions/navigation/src"],
      "@localpass/guid": ["./libs/guid/src/index.ts"],
      "@localpass/importer-core": ["./libs/importer/src"],
      "@localpass/importer-ui": ["./libs/importer/src/components"],
      "@localpass/key-management": ["./libs/key-management/src"],
      "@localpass/key-management-ui": ["./libs/key-management-ui/src"],
      "@localpass/legacy-crypto": ["./libs/legacy-crypto/src/index.ts"],
      "@localpass/legacy-crypto/node": ["./libs/legacy-crypto/src/node/index.ts"],
      "@localpass/legacy-crypto/*": ["./libs/legacy-crypto/src/*"],
      "@localpass/logging": ["./libs/logging/src"],
      "@localpass/logging-angular": ["./libs/logging-angular/src/index.ts"],
      "@localpass/messaging": ["./libs/messaging/src/index.ts"],
      "@localpass/node/*": ["./libs/node/src/*"],
      "@localpass/nx-plugin": ["./libs/nx-plugin/src/index.ts"],
      "@localpass/organization-invite-link": ["./libs/organization-invite-link/src/index.ts"],
      "@localpass/platform": ["./libs/platform/src"],
      "@localpass/platform/*": ["./libs/platform/src/*"],
      "@localpass/pricing": ["./libs/pricing/src/index.ts"],
      "@localpass/scheduling": ["./libs/scheduling/src/index.ts"],
      "@localpass/send-ui": ["./libs/tools/send/send-ui/src"],
      "@localpass/serialization": ["./libs/serialization/src/index.ts"],
      "@localpass/state": ["./libs/state/src/index.ts"],
      "@localpass/state-internal": ["./libs/state-internal/src/index.ts"],
      "@localpass/state-test-utils": ["./libs/state-test-utils/src/index.ts"],
      "@localpass/storage-core": ["./libs/storage-core/src/index.ts"],
      "@localpass/storage-test-utils": ["./libs/storage-test-utils/src/index.ts"],
      "@localpass/subscription": ["./libs/subscription/src/index.ts"],
      "@localpass/ui-common": ["./libs/ui/common/src"],
      "@localpass/ui-common/setup-jest": ["./libs/ui/common/src/setup-jest"],
      "@localpass/unlock": ["./libs/unlock/src/index.ts"],
      "@localpass/user-core": ["./libs/user-core/src/index.ts"],
      "@localpass/user-crypto-management": ["./libs/user-crypto-management/src/index.ts"],
      "@localpass/vault": ["./libs/vault/src"],
      "@localpass/vault-export-core": ["./libs/tools/export-vault-core/src"],
      "@localpass/vault-export-ui": ["./libs/tools/export-vault-ui/src"],
      "@localpass/storybook": ["./libs/storybook/src/index.ts"],
      "@localpass/managed-settings": ["./libs/managed-settings/src/index.ts"],
      "@localpass/tools-share": ["./libs/tools/share/src/index.ts"],
      "@localpass/local-vault": ["./libs/local-vault/src/index.ts"]
    },
    "plugins": [
      {
        "name": "typescript-strict-plugin"
      }
    ],
    "useDefineForClassFields": false
  }
}

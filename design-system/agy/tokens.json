{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Reference snapshot for the AGY prototype (73 screens: 1 linkage sandbox + 29 mac + 29 ext + 14 web). Not imported or consumed at runtime by product code; product styling lives in libs/components/src/tw-theme.css and libs/angular/src/local-ui/agy.scss. Semantic colors mirror the tw-theme source tokens.",
  "color": {
    "brand": {
      "primary": {
        "$value": "#175DDC",
        "$type": "color",
        "$description": "Aligned with --color-brand-700"
      },
      "hover": {
        "$value": "#0D43AF",
        "$type": "color",
        "$description": "Aligned with --color-brand-800"
      },
      "soft": { "$value": "#EAF1FF", "$type": "color" },
      "softer": { "$value": "#F5F8FF", "$type": "color" },
      "darkPrimary": { "$value": "#3B82F6", "$type": "color" },
      "darkText": {
        "$value": "#6BAEFA",
        "$type": "color",
        "$description": "Aligned with --color-brand-400"
      }
    },
    "neutral": {
      "light": {
        "app": { "$value": "#EEF2F7", "$type": "color" },
        "surface": { "$value": "#FFFFFF", "$type": "color" },
        "alt": { "$value": "#F7F9FC", "$type": "color" },
        "hover": { "$value": "#F1F5FA", "$type": "color" },
        "border": { "$value": "#E2E8F0", "$type": "color" },
        "borderLight": { "$value": "#EDF2F7", "$type": "color" },
        "textMain": { "$value": "#0F172A", "$type": "color" },
        "textSecondary": { "$value": "#475569", "$type": "color" },
        "textMuted": { "$value": "#64748B", "$type": "color" }
      },
      "dark": {
        "app": { "$value": "#090D14", "$type": "color" },
        "surface": { "$value": "#111722", "$type": "color" },
        "alt": { "$value": "#161E2C", "$type": "color" },
        "hover": { "$value": "#1D2738", "$type": "color" },
        "border": { "$value": "#242F42", "$type": "color" },
        "borderLight": { "$value": "#1C2536", "$type": "color" },
        "textMain": { "$value": "#F1F5F9", "$type": "color" },
        "textSecondary": { "$value": "#B6C2D4", "$type": "color" },
        "textMuted": { "$value": "#8896AB", "$type": "color" }
      }
    },
    "semantic": {
      "success": {
        "$value": "#008236",
        "$type": "color",
        "$description": "Reference snapshot only (not runtime-consumed). Matches --color-fg-success (--color-green-700) in tw-theme.css."
      },
      "warning": {
        "$value": "#cc4400",
        "$type": "color",
        "$description": "Reference snapshot only (not runtime-consumed). Matches --color-fg-warning (--color-orange-600) in tw-theme.css."
      },
      "danger": {
        "$value": "#c10007",
        "$type": "color",
        "$description": "Reference snapshot only (not runtime-consumed). Matches --color-fg-danger (--color-red-700) in tw-theme.css."
      }
    }
  },
  "font": {
    "sans": {
      "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', 'Inter', 'Helvetica Neue', sans-serif",
      "$type": "fontFamily"
    },
    "mono": {
      "$value": "'SF Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "$type": "fontFamily"
    }
  },
  "spacing": {
    "grid": { "$value": "4px", "$type": "dimension" },
    "subgrid": { "$value": "2px", "$type": "dimension" },
    "rowMac": { "$value": "36px", "$type": "dimension" },
    "rowMacUltra": { "$value": "30px", "$type": "dimension" },
    "rowExt": { "$value": "36px", "$type": "dimension" },
    "rowField": { "$value": "30px", "$type": "dimension" },
    "rowInline": { "$value": "36px", "$type": "dimension" }
  },
  "radius": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "6px", "$type": "dimension" },
    "md": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "10px", "$type": "dimension" }
  },
  "motion": {
    "fast": { "$value": "110ms", "$type": "duration" },
    "standard": { "$value": "160ms", "$type": "duration" }
  }
}
